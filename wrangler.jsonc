{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "shuttle",
  "main": "src/worker.ts",
  "compatibility_date": "2026-09-22",
  "compatibility_flags": ["nodejs_compat"],
  "routes": [{ "pattern": "shuttle.calpoly.place", "custom_domain": true }],
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*", "/ws"]
  },
  "durable_objects": {
    "bindings": [
      { "name": "SHUTTLE", "class_name": "ShuttleState" }
    ]
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["ShuttleState"] }
  ],
  "observability": { "enabled": true, "head_sampling_rate": 1 }
}
